<Window x:Class="SpaceLens.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SpaceLens.ViewModels"
        xmlns:views="clr-namespace:SpaceLens.Views"
        Title="SpaceLens — disk space &amp; performance"
        Icon="pack://application:,,,/SpaceLens;component/Assets/SpaceLens.ico"
        Width="1360" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DiskMapViewModel}">
            <views:DiskMapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <views:MonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image Source="pack://application:,,,/SpaceLens;component/Assets/SpaceLens.ico" Width="28" Height="28" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SpaceLens" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Disk &amp; performance doctor" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ElevationText}" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Visibility="{Binding IsElevated, Converter={StaticResource Hidden}}" TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,6"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="Administrator mode scans protected folders and shows per-app network use." />
                        <Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" FontSize="12" Padding="8,4"
                                Visibility="{Binding IsElevated, Converter={StaticResource Hidden}}" />
                    </StackPanel>
                </Border>

                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{StaticResource AccentBrush}" Width="22" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedPage.Page}" Margin="24,20,24,18" Focusable="False" />
    </Grid>
</Window>
