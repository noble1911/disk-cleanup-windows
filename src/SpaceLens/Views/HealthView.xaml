<UserControl x:Class="SpaceLens.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceLens.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="UsageList" DataType="{x:Type vm:UsageRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                    <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Check again" Command="{Binding CheckCommand}" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Health Check" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Finds what's slowing your PC down — CPU, memory, disk, network, startup apps — and tells you what to do about it." />
            </StackPanel>
        </DockPanel>

        <!-- Verdict -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,16,0,12"
                Background="{Binding Overall, Converter={StaticResource SeveritySoftBrush}}" BorderThickness="0">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="72" Height="72" Margin="0,0,16,0">
                    <Ellipse Stroke="{Binding Overall, Converter={StaticResource SeverityBrush}}" StrokeThickness="5" />
                    <TextBlock Text="{Binding Score}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding Overall, Converter={StaticResource SeverityBrush}}" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Verdict}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VerdictDetail}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ObservedText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <ProgressBar Style="{StaticResource ThinBar}" IsIndeterminate="True" Height="3" Margin="0,6,0,0" Width="200" HorizontalAlignment="Left"
                                 Visibility="{Binding IsChecking, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Findings -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,0,12,0"
                                        Background="{Binding Severity, Converter={StaticResource SeveritySoftBrush}}">
                                    <TextBlock Style="{StaticResource Icon}" HorizontalAlignment="Center" Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </Border>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Area}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,2,0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Border Visibility="{Binding HasRecommendation, Converter={StaticResource Visible}}" Background="{StaticResource SubtleFillBrush}"
                                            CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE82F;" FontSize="14" VerticalAlignment="Top"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,1,8,0" />
                                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FindingActionViewModel}">
                                                <Button Content="{Binding Label}" Command="{Binding RunCommand}" Margin="0,0,8,0" FontSize="12" Padding="10,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Side panel -->
        <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Biggest resource users (last 30 s)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="CPU" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource CpuBrush}" />
                        <ItemsControl ItemsSource="{Binding TopCpu}" ItemTemplate="{StaticResource UsageList}" Margin="0,2,0,10" />
                        <TextBlock Text="Memory" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource MemoryBrush}" />
                        <ItemsControl ItemsSource="{Binding TopMemory}" ItemTemplate="{StaticResource UsageList}" Margin="0,2,0,10" />
                        <TextBlock Text="Disk I/O" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource DiskBrush}" />
                        <ItemsControl ItemsSource="{Binding TopDisk}" ItemTemplate="{StaticResource UsageList}" Margin="0,2,0,10" />
                        <TextBlock Text="{Binding NetworkHeader}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource NetworkBrush}" />
                        <ItemsControl ItemsSource="{Binding TopNetwork}" ItemTemplate="{StaticResource UsageList}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Manage" Command="{Binding OpenStartupSettingsCommand}" VerticalAlignment="Center" />
                            <TextBlock Text="Startup apps" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding StartupItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3" ToolTip="{Binding Command}">
                                        <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="On" />
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Text" Value="Off" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                            <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="This PC" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SystemText}" TextWrapping="Wrap" FontSize="12.5" />
                        <TextBlock Text="{Binding HardwareText}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
