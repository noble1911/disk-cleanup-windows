<UserControl x:Class="SpaceLens.Views.DiskMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SpaceLens.Controls"
             xmlns:vm="clr-namespace:SpaceLens.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh drive list" Command="{Binding RefreshDrivesCommand}" Margin="0,0,8,0" />
                <Button Content="Scan folder…" Command="{Binding ScanFolderCommand}" Margin="0,0,8,0" />
                <Button Content="Scan all drives" Command="{Binding ScanAllCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Scan selected" Command="{Binding ScanSelectedCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Disk Map" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Every rectangle is a folder or file, sized by how much space it takes. Big blocks are where your space went." />
            </StackPanel>
        </DockPanel>

        <!-- Drives -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}" Margin="0,16,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DriveItemViewModel}">
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,10" Width="236">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalContentAlignment="Top">
                            <StackPanel Margin="6,0,0,0" Width="196">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,7,0,5"
                                             Foreground="{Binding UsedPercent, Converter={StaticResource LoadBrush}}" />
                                <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Status / progress -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding CancelCommand}" Padding="12,3"
                        Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" Margin="0,6,10,0">
                        <ProgressBar Style="{StaticResource ThinBar}" IsIndeterminate="True" Height="4" />
                        <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentPathText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Breadcrumb / toolbar -->
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Up one level" Command="{Binding GoUpCommand}" Margin="0,0,8,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Colour: folders / file types" Command="{Binding ToggleColorModeCommand}" FontSize="12" Padding="10,4"
                        ToolTip="Switch between colouring by top-level folder and by type of file (video, images, archives…)" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" FontSize="13" Content="{Binding Name}"
                                    Command="{Binding DataContext.ZoomToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Node}" />
                            <TextBlock Text="  ›  " Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Tree + map -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <TreeView x:Name="Tree" ItemsSource="{Binding TreeRoots}" BorderThickness="0" Background="Transparent" Padding="4"
                          SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="1,2" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}" ItemsSource="{Binding Children}">
                            <Grid Width="290" ToolTip="{Binding Node.FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                    <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent, Mode=OneWay}" Height="5" ToolTip="{Binding PercentText}" />
                                </Grid>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <controls:TreemapControl x:Name="Map"
                                         Root="{Binding CurrentNode}"
                                         Selected="{Binding SelectedNode, Mode=TwoWay}"
                                         Version="{Binding MapVersion}"
                                         ColorMode="{Binding ColorMode}"
                                         HoverChanged="Map_HoverChanged"
                                         NodeActivated="Map_NodeActivated"
                                         NodeContextRequested="Map_NodeContextRequested" />
            </Border>
        </Grid>

        <!-- Info bar -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open in Explorer" Command="{Binding OpenSelectedCommand}" Margin="0,0,6,0" FontSize="12" Padding="10,4" />
                    <Button Content="Zoom in" Command="{Binding ZoomSelectedCommand}" Margin="0,0,6,0" FontSize="12" Padding="10,4" />
                    <Button Content="Move to Recycle Bin" Command="{Binding RecycleSelectedCommand}" FontSize="12" Padding="10,4" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding InfoTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding InfoDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
