<UserControl x:Class="SpaceLens.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SpaceLens.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Diagnose slowdowns" Command="{Binding OpenHealthCheckCommand}" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="System Monitor" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
            </StackPanel>
        </DockPanel>

        <!-- Tiles -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,16,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE950;" Foreground="{StaticResource CpuBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="CPU" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource BigNumber}" Text="{Binding CpuPercent, StringFormat={}{0:0}%}" Margin="0,6,0,0" />
                    <controls:Sparkline Values="{Binding CpuSeries}" Maximum="100" Stroke="{StaticResource CpuBrush}" Height="46" Margin="0,6" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding CpuDetail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEEA0;" Foreground="{StaticResource MemoryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Memory" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource BigNumber}" Text="{Binding MemoryText}" FontSize="22" Margin="0,8,0,2" />
                    <controls:Sparkline Values="{Binding MemorySeries}" Maximum="100" Stroke="{StaticResource MemoryBrush}" Height="46" Margin="0,6" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding MemoryDetail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Foreground="{StaticResource DiskBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Disk" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource BigNumber}" Text="{Binding DiskText}" Margin="0,6,0,0" />
                    <controls:Sparkline Values="{Binding DiskSeries}" Maximum="100" Stroke="{StaticResource DiskBrush}" Height="46" Margin="0,6" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DiskDetail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE839;" Foreground="{StaticResource NetworkBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Network" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource BigNumber}" Text="{Binding NetworkText}" FontSize="18" Margin="0,10,0,3" TextTrimming="CharacterEllipsis" />
                    <controls:Sparkline Values="{Binding NetworkSeries}" Stroke="{StaticResource NetworkBrush}" Height="46" Margin="0,6" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding NetworkDetail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Admin banner -->
        <Border Grid.Row="2" Background="{StaticResource InfoSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding IsElevated, Converter={StaticResource Hidden}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" FontSize="12" Padding="10,3" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                           Text="Network per app shows “—” because Windows only reveals per-app traffic to administrators. Connection counts are still shown." />
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open file location" Command="{Binding OpenLocationCommand}" Margin="0,0,6,0" FontSize="12" Padding="10,4" />
                <Button Content="Look it up online" Command="{Binding SearchOnlineCommand}" Margin="0,0,6,0" FontSize="12" Padding="10,4" />
                <Button Content="End task" Command="{Binding EndTaskCommand}" FontSize="12" Padding="10,4" />
            </StackPanel>
            <TextBox Width="260" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name, description or PID" />
            <CheckBox Content="Group by app" IsChecked="{Binding GroupByApp}" Margin="14,0,0,0" />
            <TextBlock Text="{Binding NetworkNote}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Process table -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding ProcessView}" SelectedItem="{Binding SelectedRow}" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" SortMemberPath="Name" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" SortMemberPath="Description" />
                <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="90" SortMemberPath="Count" />
                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" Width="70" SortMemberPath="Cpu" SortDirection="Descending" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="90" SortMemberPath="Memory" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Disk I/O" Binding="{Binding IoText}" Width="95" SortMemberPath="Io" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Network" Binding="{Binding NetText}" Width="90" SortMemberPath="Net" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Conns" Binding="{Binding Connections}" Width="62" SortMemberPath="Connections" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="68" SortMemberPath="Threads" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="72" SortMemberPath="Handles" ElementStyle="{StaticResource RightCell}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
